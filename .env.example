# Postgres — the same database the API reads. The ETL writes courses,
# sections, grades and RMP data here.
DATABASE_URL=

# Redis — query cache shared with the API. `npm run flush-cache` clears it
# after a load so the API stops serving stale results.
REDIS_URL=

# Madgrades API. `npm run madgrades-token` can fetch this automatically,
# which is what the GITHUB_* variables below are for.
MADGRADES_API_TOKEN=

# Term to extract, as a UW term code (e.g. 1272 = Spring 2027).
# Defaults to 1272 if unset.
SELECTED_TERM=

# Email (self-hosted SMTP, same Mox server the API uses). Required by
# `npm run notify`, which sends seat-open notifications. Without SMTP_HOST
# the notify job throws rather than silently skipping.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Only needed by `npm run madgrades-token`, which rotates the Madgrades
# token and writes it back to the repo's GitHub Actions secrets.
GITHUB_TOKEN=
GITHUB_USERNAME=
GITHUB_PASSWORD=
GITHUB_REPOSITORY=
GITHUB_REPOSITORY_OWNER=

# Course extractor runs Puppeteer; set false to watch it work.
PUPPETEER_HEADLESS=true

# Tuning (all optional, defaults shown)
BATCH_SIZE=100
MAX_RETRIES=3
RATE_LIMIT_DELAY=100
DEBUG=false

# Testing (optional)
TEST_MODE=false
TEST_COURSE_LIMIT=50
