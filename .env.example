# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-db-password
DB_NAME=badgerbase

# Redis
REDIS_PUBLIC_URL=redis://localhost:6379

# Madgrades API
MADGRADES_API_TOKEN=your-madgrades-api-token

# Email (for subscription notifications)
ELASTIC_EMAIL_API_KEY=your-elasticemail-key
FROM_EMAIL=noreply@badgerbase.app

# Puppeteer (course extractor)
PUPPETEER_HEADLESS=true

# Tuning (optional)
BATCH_SIZE=100
MAX_RETRIES=3
RATE_LIMIT_DELAY=1000
DEBUG=false
