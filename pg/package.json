{
  "name": "badgerbase-pg-etl",
  "version": "1.0.0",
  "description": "TypeScript ETL pipeline for BadgerBase PostgreSQL migration",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "seed": "tsx src/seed.ts",
    "extract:courses": "tsx src/extractors/courses.ts",
    "extract:madgrades": "tsx src/extractors/madgrades.ts",
    "extract:rmp": "tsx src/extractors/rmp.ts",
    "load": "tsx src/run-dumps.ts",
    "db:init": "tsx src/db-init.ts",
    "waf-token": "tsx src/utils/get-waf-token.ts",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "dotenv": "^17.2.2",
    "fuzzball": "^2.2.6",
    "pg": "^8.13.1",
    "puppeteer": "^24.32.1",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.10",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
